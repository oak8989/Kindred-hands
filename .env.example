# ============================================
# Kindred Hands Environment Configuration
# ============================================
# Copy this file to .env and modify values as needed.
# NEVER commit .env to version control.
# Secrets should NEVER be committed to git.

# ---- Application ----
# Port on the HOST machine that maps to the container
HOST_PORT=3000

# Organization name (also configurable via setup wizard)
APP_NAME=Kindred Hands

# Public URL of the application (used for email links)
APP_URL=http://localhost:3000

# JWT secret for signing tokens
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-64-char-string

# ---- Database ----
POSTGRES_DB=kindredhands
POSTGRES_USER=kindredhands
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=change-me-to-a-strong-password

# ---- Redis ----
# Password for Redis session store and rate limiting
# Generate with: openssl rand -base64 32
REDIS_PASSWORD=change-me-to-a-strong-password

# ---- Email Configuration ----
# Mode: console | file | smtp
# - console: Logs emails to Docker logs (default, works immediately)
# - file: Saves emails to /data/logs/emails/
# - smtp: Sends via SMTP server (requires settings below)
EMAIL_MODE=console

# SMTP Settings (only required when EMAIL_MODE=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@example.com

# ---- Logging ----
LOG_LEVEL=info

# ---- TLS/HTTPS (for production internet exposure) ----
# DOMAIN=kindred-hands.example.com
# CERT_PATH=/etc/letsencrypt/live/kindred-hands.example.com
# EMAIL=admin@example.com
