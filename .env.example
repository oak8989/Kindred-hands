# ============================================
# VolunteerHub Environment Configuration
# ============================================
# Copy this file to .env and modify values as needed.
# NEVER commit .env to version control.
# Secrets should NEVER be committed to git.

# ---- Application ----
# Port on the HOST machine that maps to the container
HOST_PORT=3000

# Organization name (also configurable via setup wizard)
APP_NAME=VolunteerHub

# Public URL of the application (used for email links)
APP_URL=http://localhost:3000

# Secret key for session signing and token generation
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-64-char-string

# ---- Database ----
POSTGRES_DB=volunteerhub
POSTGRES_USER=volunteerhub
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=change-me-to-a-strong-password

# Full database connection URL (constructed from above values)
DATABASE_URL=postgresql://volunteerhub:change-me-to-a-strong-password@db:5432/volunteerhub

# ---- Redis ----
# Password for Redis session store and rate limiting
# Generate with: openssl rand -base64 32
REDIS_PASSWORD=change-me-to-a-strong-password

# ---- Email Configuration ----
# Mode: console | file | smtp
# - console: Logs emails to Docker logs (default, works immediately)
# - file: Saves emails to /data/logs/emails/
# - smtp: Sends via SMTP server (requires settings below)
EMAIL_MODE=console

# SMTP Settings (only required when EMAIL_MODE=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@example.com

# ---- Rate Limiting ----
# Window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Maximum requests per window per IP
RATE_LIMIT_MAX=20

# ---- TLS/HTTPS (for production internet exposure) ----
# These are used by the reverse proxy configuration
# DOMAIN=volunteer.example.com
# CERT_PATH=/etc/letsencrypt/live/volunteer.example.com
# EMAIL=admin@example.com
